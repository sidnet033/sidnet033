# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed if you turn on Google Sheet sync for the item master.
# Create a Google Cloud service account, share your Sheet with its email
# address as a Viewer, then paste its client_email and private_key here.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Item Master!A:G
